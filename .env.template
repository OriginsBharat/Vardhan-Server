# --- Discord Secrets ---
# You can get these from the Discord Developer Portal for your bot application.
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE
DISCORD_GUILD_ID=YOUR_DISCORD_SERVER_ID_HERE
USER_ID=YOUR_DISCORD_USER_ID_HERE
DISCORD_EVENT_CHANNEL_ID=YOUR_EVENT_CHANNEL_ID_HERE
DISCORD_CONTROL_CHANNEL_ID=YOUR_PRIVATE_CONTROL_CHANNEL_ID_HERE
DISCORD_AUCTION_CHANNEL_ID=YOUR_AUCTION_CHANNEL_ID_HERE

# --- Self-Hosted AI Service URLs ---
# These should point to the services running on your VPS. Defaults are standard.
OLLAMA_API_URL=http://127.0.0.1:11434
COMFYUI_API_URL=http://127.0.0.1:8188
XTTS_API_URL=http://127.0.0.1:8010

# --- VPS Portability ---
# Enter the end date of your VPS trial here (e.g., "2025-11-01").
# Leave this blank to disable the countdown timer.
TRIAL_END_DATE=""