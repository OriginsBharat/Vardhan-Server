# ===============================================================
#  My AI World - Environment Configuration
# ===============================================================
# Master, please fill in these values before running setup_world.bat
# This file should be renamed to .env after you fill it out.
# ===============================================================

# --- Discord Secrets ---
# Your Discord bot's unique token.
DISCORD_BOT_TOKEN=
# The ID of the Discord server (guild) where the world will operate.
DISCORD_GUILD_ID=
# Your personal Discord User ID, to identify you as the Master.
USER_ID=

# --- Local AI Engine Paths ---
# The full, absolute path to your ComfyUI installation directory.
# Example: C:\Users\YourUser\AI\ComfyUI_windows_portable
COMFYUI_PATH=
# The full path to your XTTS voice model directory (if you have a custom one).
# Leave blank to use the default.
XTTS_PATH=

# --- Pinecone Cloud Memory ---
# Your API key from your free Pinecone account.
PINECONE_API_KEY=
# The full host URL for your Pinecone index.
# Find this in your Pinecone dashboard after creating an index.
# Example: my-index-123ab.svc.us-west1-gcp.pinecone.io
PINECONE_INDEX_HOST=

# --- API Endpoints (ADVANCED) ---
# You should not need to change these unless you have a custom setup.
# These are the local addresses for the AI engines.
OLLAMA_API_URL=http://127.0.0.1:11434
COMFYUI_API_URL=http://127.0.0.1:8188
XTTS_API_URL=http://127.0.0.1:8010